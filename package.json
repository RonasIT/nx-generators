  "main": "./src/index.js",
  "typings": "./src/index.d.ts",
  "workspaces": [
    "apps/*",
    "plugin/*"
  ],
  "lint-staged": {
    "*.{ts,tsx}": "tsc-files --noEmit types.d.ts",
    "*.{ts,tsx,js,html,json,md,css,scss}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --cache --fix",
    "*.{css,scss}": "stylelint --fix --allow-empty-input"
  }
