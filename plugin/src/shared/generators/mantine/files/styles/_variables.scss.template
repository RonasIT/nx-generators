$mobile: 767px;
$tablet: 1023px;
$small-desktop: 1199px;

:root {
  --brand-primary: #BF4B4B;
  --brand-secondary: #56A9DC;

  --background-primary: #F7F6F2;
  --background-secondary: #FFFFFF;

  --text-primary: #241B17;
  --text-secondary: #3C2F29;

  --font-size-h1: 3rem;
  --font-size-h2: 1.75rem;
  --font-size-h3: 1.375rem;
  --font-size-h4: 1.25rem;
  --font-size-h5: 0.75rem;

  --font-size-large: 1.125rem;
  --font-size-default: 1rem;
  --font-size-small: 0.875rem;
  --font-size-extra-small: 0.75rem;

  --max-content-width: 1200px;
  --screen-padding: 16px;

  @media (max-width: $mobile) {
    --font-size-h1: 1.75rem;
    --font-size-h2: 1.625rem;
    --font-size-h3: 1.125rem;
    --font-size-h4: 1.125rem;
    --font-size-h5: 0.625rem;

    --font-size-large: 1.0625rem;
    --font-size-default: 0.875rem;
    --font-size-small: 0.75rem;
    --font-size-extra-small: 0.625rem;
  }
}
