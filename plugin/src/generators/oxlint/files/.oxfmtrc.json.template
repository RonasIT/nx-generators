{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "bracketSameLine": true,
  "singleAttributePerLine": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.yalc/**",
    "**/dist/**",
    "**/coverage/**",
    "**/output/**",
    "**/.next/**",
    "**/.nx/**",
    "**/android/**",
    "**/ios/**"
  ]
}
