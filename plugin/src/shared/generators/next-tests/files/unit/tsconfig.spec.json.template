{
  "extends": "./<%= extendsConfig %>",
  "compilerOptions": {
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["vite.config.mts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules"]
}
