import { ReactElement, RefObject } from 'react';
import { Control, FieldValues, Path, useController } from 'react-hook-form';
import { TextInput } from 'react-native';
import { StaticTextInput, StaticTextInputProps } from '../static-text-input';

export interface FormStaticTextInputProps<T extends FieldValues> extends StaticTextInputProps {
  name: Path<T>;
  control: Control<T>;
  inputRef?: RefObject<TextInput | null>;
}

export function FormStaticTextInput<T extends FieldValues>({
  name,
  control,
  inputRef,
  ...restProps
}: FormStaticTextInputProps<T>): ReactElement {
  const { field, fieldState } = useController({ control, name });

  return (
    <StaticTextInput
      ref={inputRef}
      value={field.value}
      onChangeText={field.onChange}
      onBlur={field.onBlur}
      error={fieldState.error?.message}
      {...restProps}
    />
  );
}
