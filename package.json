{
  "name": "@ronas-it/nx-generators-workspace",
  "description": "Nx generators for Ronas IT projects",
  "license": "MIT",
  "author": "Ronas IT",
  "private": true,
  "scripts": {
    "deps:sync": "npx syncpack fix",
    "deps:check-generators": "node tools/scripts/check-generator-dependencies.mjs",
    "lint": "npx tsc && npx eslint ./",
    "lint:css": "npx stylelint \"**/*.{css,scss}\" --fix --allow-empty-input",
    "format": "npx prettier --write . && npm run lint -- --fix && npm run lint:css",
    "prepare": "husky",
    "build": "npx nx run nx-generators:build",
    "release": "npx nx run nx-generators:nx-release-publish",
    "test": "npx nx run nx-generators:test",
    "test:e2e": "node e2e/run.mjs"
  },
